<div class="card-group">
  <div class="card">
    <div class="card-body">
      <h5 class="card-title">Total users</h5>
      <p class="card-text fs-1"><%= total_users %></p>
    </div>
  </div>
  <div class="card">
    <div class="card-body">
      <h5 class="card-title">Users by Role</h5>
      <ul class="list-group list-group-flush">
        <li class="list-group-item d-flex justify-content-between align-items-center">
          Admins
          <span class="badge bg-primary rounded-pill"><%= users_by_role["admin"] || 0 %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          Users
          <span class="badge bg-secondary rounded-pill"><%= users_by_role["user"] || 0 %></span>
        </li>
      </ul>
    </div>
  </div>

</div>
